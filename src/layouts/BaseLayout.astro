---
import { Font } from 'astro:assets';
import logoImage from '../assets/images/logo.png';
import SiteFooter from '../components/SiteFooter';
import SiteHeader from '../components/SiteHeader';
import { site } from '../data/site';
import { imagePresets, optimizeImage } from '../lib/images';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = `Join ${site.couple.first} and ${site.couple.second} on ${site.dateLong}.`,
} = Astro.props;

const logo = await optimizeImage(logoImage, imagePresets.logo);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<title>{`${site.title} - ${title}`}</title>
		<Font cssVariable="--font-display" preload />
		<Font cssVariable="--font-script" preload />
		<Font cssVariable="--font-body" />
		<!--
			Scroll reveal (styles in global.css). Inline in <head> so content is hidden before the first
			paint instead of flashing in and out. Elements that enter the viewport together are staggered,
			and data-reveal is removed once each finishes so the element's own transitions apply again.
			Content is only hidden when IntersectionObserver exists to reveal it again.
		-->
		<script is:inline>
			if ('IntersectionObserver' in window) {
				document.documentElement.classList.add('reveal-ready');

				addEventListener('DOMContentLoaded', () => {
					const observer = new IntersectionObserver(
						(entries) => {
							entries
								.filter((entry) => entry.isIntersecting)
								.forEach((entry, index) => {
									const el = entry.target;
									observer.unobserve(el);
									// Capped so a large batch (e.g. a very tall screen) doesn't leave items waiting.
									el.style.transitionDelay = `${Math.min(index, 8) * 120}ms`;
									el.addEventListener('transitionend', function done(event) {
										if (event.target !== el) return;
										el.removeEventListener('transitionend', done);
										el.removeAttribute('data-reveal');
										el.style.transitionDelay = '';
									});
									el.classList.add('is-revealed');
								});
						},
						// A share of the element rather than an offset from the screen edge, so elements at the
						// very end of the page still reveal once scrolled fully into view.
						{ threshold: 0.15 },
					);

					document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
				});
			}
		</script>
	</head>
	<body>
		<SiteHeader currentPath={Astro.url.pathname} logo={logo} />
		<slot />
		<SiteFooter />

		<script>
			// The header is rendered at build time from the page path, which can't see #schedule or
			// #details. Re-mark the current nav link from the full URL on load and on every hash change.
			const normalize = (url: URL | Location) => url.pathname.replace(/(.)\/$/, '$1') + url.hash;

			function markCurrentNavLink() {
				const here = normalize(location);

				document.querySelectorAll<HTMLAnchorElement>('a[data-nav-link]').forEach((link) => {
					const target = new URL(link.href);

					if (normalize(target) === here) {
						link.setAttribute('aria-current', target.hash ? 'location' : 'page');
					} else {
						link.removeAttribute('aria-current');
					}
				});
			}

			markCurrentNavLink();
			addEventListener('hashchange', markCurrentNavLink);
		</script>
		<script>
			import '../scripts/shy-header';
		</script>
	</body>
</html>
