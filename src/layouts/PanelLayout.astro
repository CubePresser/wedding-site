---
import BaseLayout from './BaseLayout.astro';

interface Props {
	title: string;
	heading: string;
	description?: string;
}

const { title, heading, description } = Astro.props;
---

<!-- Interior page from the FAQ mockup: pinstripes, a cream panel, and a script heading across its top edge. -->
<BaseLayout title={title} description={description}>
	<main class="bg-stripes-olive">
		<div class="container panel">
			<h1 class="script heading">{heading}</h1>
			<slot />
		</div>
	</main>
</BaseLayout>

<style>
	main {
		padding-block: 160px 80px;
	}

	.panel {
		display: flow-root;
		background: var(--color-cream);
		padding: 0 clamp(20px, 5vw, 64px) 56px;
	}

	.heading {
		margin-top: -0.55em;
		margin-bottom: 0.35em;
		color: var(--color-cream);
		font-size: clamp(4rem, 9vw, 7.5rem);
		line-height: 1;
		text-align: center;
		-webkit-text-stroke: 6px var(--color-olive);
		paint-order: stroke fill;
	}
</style>
