---
import { site } from '../../data/site';
import Section from '../ui/Section.astro';
---

<Section tone="photo">
	<div class="panel flow">
		<h2 class="script">Our Special Day</h2>
		<p>
			We are so excited to celebrate this wonderful moment in our lives with our closest friends and
			families. Your love and support means the world to us and we can't wait to share this
			unforgettable day with you.
		</p>
		<p>
			As we countdown to our big day we've created a website to keep you updated on all the details.
		</p>
		<p>
			Thank you for being a part of our journey. We can't wait to celebrate with all of you.
		</p>
		<p>With Love,</p>
		<p class="script signature">{site.couple.first} &amp; {site.couple.second}</p>
	</div>
</Section>

<style>
	.panel {
		padding: clamp(24px, 4vw, 48px) clamp(20px, 15vw, 196px);
		background: rgb(117 112 90 / 0.65);
		font-size: var(--text-lg);
		text-align: center;
	}

	h2 {
		font-size: var(--text-2xl);
	}

	.signature {
		font-size: var(--text-xl);
	}
</style>
