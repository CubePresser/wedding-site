---
import lake from '../../assets/placeholder/photo-lake.png';
import mountain from '../../assets/placeholder/photo-mountain.png';
import paris from '../../assets/placeholder/photo-paris.png';
import FramedPhoto from '../ui/FramedPhoto.astro';
import Section from '../ui/Section.astro';

const photos = [
	{ src: mountain, alt: 'Rachel and Alex with arms raised on a boulder above a mountain valley' },
	{ src: paris, alt: 'Rachel and Alex taking a selfie in front of the Eiffel Tower' },
	{ src: lake, alt: 'Rachel and Alex in sunglasses taking a selfie by a lake' },
];
---

<Section tone="stripes">
	<div class="photos">
		{photos.map((photo) => <FramedPhoto src={photo.src} alt={photo.alt} />)}
	</div>
</Section>

<style>
	.photos {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 322px));
		justify-content: center;
		gap: clamp(32px, 6vw, 80px);
	}
</style>
