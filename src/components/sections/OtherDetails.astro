---
import { details } from '../../data/details';
import Section from '../ui/Section.astro';
---

<Section id="details">
	<h2 class="script">Other Details</h2>
	<div class="grid">
		{
			details.map((detail) => (
				<article>
					<h3 class="display">{detail.title}</h3>
					<div class="flow">
						{detail.body.map((paragraph) => (
							<p>{paragraph}</p>
						))}
					</div>
				</article>
			))
		}
	</div>
</Section>

<style>
	h2 {
		font-size: clamp(3.5rem, 8vw, 6.5rem);
		text-align: right;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 56px clamp(32px, 6vw, 80px);
		margin-top: 72px;
		text-align: right;
	}

	h3 {
		margin-bottom: 0.4em;
		font-size: var(--text-xl);
	}

	@media (max-width: 760px) {
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
