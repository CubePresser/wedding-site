---
import { site } from '../../data/site';
import Button from '../ui/Button.astro';
import Section from '../ui/Section.astro';
---

<Section tone="stripes">
	<div class="rsvp">
		<h2 class="display"><span class="script">Please</span> RSVP</h2>
		<p>
			Kindly let us know if you'll be joining us. Your response helps us prepare for the day. Please
			submit your RSVP through the link below no later than {site.rsvp.deadline}.
		</p>
		<Button href={site.rsvp.url}>RSVP here</Button>
	</div>
</Section>

<style>
	.rsvp {
		display: grid;
		justify-items: center;
		gap: 36px;
		max-width: 540px;
		margin-inline: auto;
		padding-block: 48px;
		text-align: center;
	}

	h2 {
		font-size: clamp(3rem, 8vw, 6.5rem);
		white-space: nowrap;
	}

	p {
		font-size: var(--text-lg);
	}
</style>
