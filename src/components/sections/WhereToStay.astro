---
import { lodging } from '../../data/details';
import Section from '../ui/Section.astro';
---

<Section tone="photo">
	<h2 class="display">Where to stay nearby</h2>
	<div class="cards">
		{
			lodging.map((option) => (
				<article class="flow">
					<h3 class="display">{option.name}</h3>
					<address>
						{option.address.map((line) => (
							<span>{line}</span>
						))}
					</address>
					<p>{option.blurb}</p>
					<p>{option.phone}</p>
				</article>
			))
		}
	</div>
</Section>

<style>
	h2 {
		font-size: var(--text-2xl);
		text-align: center;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
		gap: 40px;
		margin-top: 56px;
	}

	article {
		padding: 32px;
		background: var(--color-olive);
		font-size: 1.25rem;
		text-align: center;
	}

	h3 {
		font-size: var(--text-xl);
	}

	address {
		font-style: normal;
	}

	span {
		display: block;
	}
</style>
